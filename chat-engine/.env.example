# ----------------------------------------------------------------------------
# cp .env.example .env
#
# ⚠️ اگر با docker-compose اجرا می‌کنی: MONGO_URI، REDIS_URL،
# DEFAULT_TENANT_STORE_DATABASE_URL، JWT_ACCESS_SECRET و PORT را
# docker-compose.yml خودش override می‌کند (به نام سرویس‌های داخل شبکه‌ی
# Docker اشاره می‌کنند، نه localhost) — لازم نیست این‌ها را دستی عوض کنی.
# فقط JWT_ACCESS_SECRET را در .env ریشه‌ی پروژه (نه این فایل) درست بگذار.
# بقیه‌ی مقادیر این فایل (AI، تلگرام، CORS) دست‌نخورده استفاده می‌شوند.
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=8001
CORS_ORIGIN=http://localhost:3000

# --- دیتابیس مخصوص خودِ موتور پاسخگو (مکالمات/پیام‌ها/اپراتورها/تنانت‌ها) ---
# کاملاً مستقل از دیتابیس فروشگاه؛ MongoDB برای این نوع داده‌ی محاوره‌ای/
# سندمحور مناسب‌تر از یک جدول رابطه‌ای است.
MONGO_URI="mongodb://localhost:27017/chat_engine"

# Redis: هم برای اتصال Socket.io بین چند نمونه از سرور (وقتی افقی
# scale شود، پیام یک اپراتور روی instance دیگر باید به مشتری روی این
# instance برسد) و هم برای کش کوتاه‌مدت کوئری‌های پرتکرار دیتابیس فروشگاه
REDIS_URL="redis://localhost:6379"

# باید دقیقاً همان مقدار JWT_ACCESS_SECRET پروژه‌ی اصلی باشد تا اپراتور با
# همان توکن ورود پنل ادمین بتواند وارد بخش اپراتور این موتور هم بشود
JWT_ACCESS_SECRET=change_me_access_secret_please

# --- بوت‌استرپ تنانت پیش‌فرض (فقط در اولین اجرا، اگر tenant ای در Mongo نبود) ---
# نصب فعلی تک‌کسب‌وکاری است؛ همین یک تنانت ساخته می‌شود. روز چند-مستاجری‌شدن
# باقی تنانت‌ها مستقیم در دیتابیس/پنل مدیریت اضافه می‌شوند، نه این env.
DEFAULT_TENANT_KEY=default
DEFAULT_TENANT_NAME="فروشگاه پیش‌فرض"
# کانکشن‌استرینگ Postgres همین بک‌اند فروشگاهی (فقط خواندنی استفاده می‌شود؛
# در دیتابیس واقعی توصیه می‌شود یک role با دسترسی فقط SELECT بسازید)
DEFAULT_TENANT_STORE_DATABASE_URL="postgresql://postgres:baset4591@localhost:5432/shopdb"

# حداکثر کانکشن هم‌زمان Postgres به‌ازای هر تنانت (کش Redis اکثر ترافیک
# تکراری را جذب می‌کند؛ این برای موج سوال‌های واقعاً متفاوت است)
STORE_DB_POOL_MAX=20

# ----------------------------------------------------------------------------
# تلگرام
# ----------------------------------------------------------------------------
# polling برای توسعه (نیازی به دامنه/HTTPS ندارد)، webhook برای تولید
TELEGRAM_MODE=polling

# توکن بات از BotFather — این مقدار را هرگز کامیت نکن، فقط در .env محلی
DEFAULT_TENANT_TELEGRAM_BOT_TOKEN=

# فقط برای TELEGRAM_MODE=webhook لازم است (دامنه‌ی HTTPS واقعی سرور)
TELEGRAM_WEBHOOK_BASE_URL=

# ----------------------------------------------------------------------------
# لایه‌ی دوم (هوش مصنوعی) — قابل تعویض بین چند سرویس
# AI_PROVIDER یکی از: anthropic | openai
# ----------------------------------------------------------------------------
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# اگر لایه‌ی AI کمتر از این مقدار اطمینان داشته باشد (۰ تا ۱)، مکالمه به
# اپراتور ارجاع داده می‌شود
AI_CONFIDENCE_THRESHOLD=0.55
