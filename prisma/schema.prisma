// ============================================================================
// schema.prisma — اسکیمای کامل دیتابیس فروشگاه اینترنتی
// ----------------------------------------------------------------------------
// نکات کلی:
// - تمام مقادیر مالی (قیمت، تخفیف، موجودی کیف پول و ...) به صورت Int و در
//   واحد «تومان» در نظر گرفته شده‌اند. اگر مبالغ بسیار بزرگ (بیش از ۲٫۱ میلیارد)
//   دارید، این فیلدها را به BigInt تغییر دهید.
// - شناسه‌ها (id) از نوع cuid() هستند تا هم در سمت کلاینت قابل تولید باشند و هم
//   ترتیب‌پذیر و یکتا باشند.
// - برای جلوگیری از وابستگی سخت به یک رکورد در حال تغییر (مثل آدرس یا تنوع
//   محصول که ممکن است بعداً ویرایش/حذف شود)، در سفارش‌ها از «اسنپ‌شات» داده
//   (snapshot) استفاده شده تا تاریخچه سفارش هرگز تغییر نکند.
// ============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql" // در صورت نیاز می‌توانید به mysql تغییر دهید
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  ADMIN
  EDITOR
  SUPPORT
  CUSTOMER
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PricingMode {
  FIXED_IRT
  CURRENCY_BASED
}

enum ModifierType {
  PERCENTAGE
  FIXED_SOURCE_CURRENCY
  FIXED_IRT
}

enum DiscountType {
  PERCENT
  FIXED
}

enum AttributeInputType {
  TEXT
  COLOR
  SELECT
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
}

enum OtpChannel {
  SMS
  EMAIL
}

enum OtpPurpose {
  REGISTER
  LOGIN
  RESET_PASSWORD
  VERIFY_PHONE
  VERIFY_EMAIL
  CHANGE_PHONE
}

enum OrderStatus {
  PENDING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  RETURN_REQUESTED
  RETURNED
  REFUNDED
  FAILED
}

enum PaymentMethod {
  GATEWAY
  WALLET
  MIXED
  FREIGHT_COLLECT
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TransactionType {
  ORDER_PAYMENT
  WALLET_CHARGE
  REFUND
}

enum CancellationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ReturnStatus {
  PENDING
  APPROVED
  REJECTED
  RECEIVED
  REFUNDED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAW
  PURCHASE
  REFUND
  ADMIN_ADJUST
  WITHDRAWAL_REQUEST
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
  PENDING_CUSTOMER
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum SenderType {
  USER
  ADMIN
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
}

// برای کامنت‌های پلی‌مورفیک — قابل اتصال هم به محصول هم به پست وبلاگ
// (معادل polymorphic relation در Laravel؛ پریزما رابطه‌ی پلی‌مورفیک بومی
// ندارد، پس با یک ستون نوع + یک ستون شناسه‌ی عمومی شبیه‌سازی می‌شود)
enum CommentableType {
  PRODUCT
  BLOG_POST
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NotificationType {
  ORDER
  SYSTEM
  TICKET
  PROMOTION
  WALLET
  COMMENT
}

enum BannerPosition {
  HOME_MAIN
  HOME_MIDDLE
  CATEGORY_TOP
  SIDEBAR
}

enum WalletWithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShippingPricingType {
  FIXED
  WEIGHT_DISTANCE
}

// ============================================================================
// Users & Authentication
// ============================================================================

model User {
  id              Int       @id @default(autoincrement())
  fullName        String?
  email           String?   @unique
  phone           String?   @unique
  password        String?
  role            Role      @default(CUSTOMER)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?

  isBlocked     Boolean   @default(false)
  blockedReason String?
  blockedAt     DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  addresses          Address[]
  sessions           UserSession[]
  otpCodes           OtpCode[]
  loginAttempts      LoginAttempt[]
  wallet             Wallet?
  cart               Cart?
  wishlists          Wishlist[]
  orders             Order[]
  comments           Comment[]
  commentLikes       CommentLike[]
  tickets            Ticket[]
  ticketMessages     TicketMessage[]
  notifications      Notification[]
  discountCodeUsers  DiscountCodeUser[]
  discountCodeUsages DiscountCodeUsage[]
  transactions       Transaction[]
  uploadedMedia      Media[]             @relation("UploadedMedia")
  createdProducts    Product[]           @relation("ProductCreatedBy")
  blogPosts          BlogPost[]          @relation("BlogPostAuthor")
  auditLogs          AuditLog[]
  walletWithdrawals  WalletWithdrawal[]

  @@index([role])
}

model WalletWithdrawal {
  id                      Int                    @id @default(autoincrement())
  userId                  Int
  user                    User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount                  Int
  status                  WalletWithdrawalStatus @default(PENDING)
  description             String?
  bankSheba               String?
  bankCardNumber          String?
  bankAccountOwnerName    String?
  adminNote               String?
  trackingCode            String?
  createdAt               DateTime               @default(now())
  reviewedAt              DateTime?

  @@index([userId])
  @@index([status])
}

model Address {
  id            Int      @id @default(autoincrement())
  userId        Int
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String?
  receiverName  String
  receiverPhone String
  province      String
  city          String
  postalCode    String?
  fullAddress   String
  lat           Float?
  lng           Float?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  orders Order[]

  @@index([userId])
}

model UserSession {
  id             Int       @id @default(autoincrement())
  userId         Int
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token          String    @unique
  ip             String?
  userAgent      String?
  deviceName     String?
  isActive       Boolean   @default(true)
  lastActivityAt DateTime  @default(now())
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?

  @@index([userId])
}

model LoginAttempt {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id])
  identifier   String
  ip           String?
  userAgent    String?
  isSuccessful Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([identifier])
  @@index([ip])
}

model BlockedIp {
  id        Int       @id @default(autoincrement())
  ip        String    @unique
  reason    String?
  blockedAt DateTime  @default(now())
  expiresAt DateTime?
}

model OtpCode {
  id         Int        @id @default(autoincrement())
  userId     Int?
  user       User?      @relation(fields: [userId], references: [id])
  identifier String
  channel    OtpChannel
  purpose    OtpPurpose
  code       String
  attempts   Int        @default(0)
  isUsed     Boolean    @default(false)
  expiresAt  DateTime
  createdAt  DateTime   @default(now())

  @@index([identifier, purpose])
}

// ============================================================================
// Central Media Model — single source of truth for all uploaded files
// ============================================================================

model Media {
  id              Int       @id @default(autoincrement())
  fileName        String // generated unique filename on disk
  originalName    String // original file name from the user's upload
  filePath        String // relative path within storage (e.g. "products/abc.jpg")
  url             String // public URL for serving the file
  mimeType        String
  extension       String? // file extension extracted from original name (e.g. "jpg", "pdf", "mp4")
  size            Int // bytes
  type            MediaType
  entityType      String? // upload source: "PRODUCT", "BLOG", "STORY", "BANNER", etc.
  storageProvider String    @default("local") // storage backend identifier: "local", "s3", "cdn"
  uploadedById    Int?
  uploadedBy      User?     @relation("UploadedMedia", fields: [uploadedById], references: [id])
  metadata        Json? // flexible metadata (dimensions, duration, alt text, etc.)
  createdAt       DateTime  @default(now())

  productImages      ProductImage[]
  categoryImages     Category[]          @relation("CategoryImages")
  brandLogos         Brand[]             @relation("BrandLogos")
  shippingLogos      ShippingCompany[]   @relation("ShippingLogos")
  banners            Banner[]
  popups             Popup[]
  ticketAttachments  TicketAttachment[]
  commentAttachments CommentAttachment[]
  orderReturnImages  OrderReturnImage[]
  blogCoverImages    BlogPost[]          @relation("BlogCoverImages")
  storyCoverImages   Story[]             @relation("StoryCoverImages")
  storyVideos        Story[]             @relation("StoryVideos")

  @@index([type])
  @@index([entityType])
}

// ============================================================================
// Currency & Exchange Rates
// ============================================================================

model Currency {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  symbol      String?
  isActive    Boolean  @default(true)

  currentRate     Float?
  lastFetchedAt   DateTime?
  lastAppliedRate Float?
  lastAppliedAt   DateTime?

  rateHistory ExchangeRateHistory[]
  products    Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model ExchangeRateHistory {
  id          Int      @id @default(autoincrement())
  currencyId  Int
  currency    Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  rate          Float
  source        String
  wasApplied    Boolean   @default(false)
  changePercent Float?
  fetchedAt     DateTime  @default(now())

  @@index([currencyId, fetchedAt])
}

// ============================================================================
// Categories, Brands & Attributes
// ============================================================================

model Category {
  id              Int        @id @default(autoincrement())
  name            String
  slug            String     @unique
  description     String?
  // آدرس مستقیم تصویر — فرانت‌اند برای نمایش از این فیلد استفاده می‌کند
  imageUrl        String?
  // ارجاع به رکورد Media در کتابخانه متمرکز (برای مدیریت ادمین)
  imageMediaId    Int?
  image           Media?     @relation("CategoryImages", fields: [imageMediaId], references: [id])
  parentId        Int?
  parent          Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[] @relation("CategoryHierarchy")
  order           Int        @default(0)
  isActive        Boolean    @default(true)
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  products      ProductCategory[]
  discountCodes DiscountCodeCategory[]
  attributes    CategoryAttribute[]

  @@index([parentId])
}

model Brand {
  id              Int      @id @default(autoincrement())
  name            String
  slug            String   @unique
  description     String?
  // آدرس مستقیم لوگو — فرانت‌اند برای نمایش از این فیلد استفاده می‌کند
  logoUrl         String?
  // ارجاع به رکورد Media در کتابخانه متمرکز (برای مدیریت ادمین)
  logoMediaId     Int?
  logo            Media?   @relation("BrandLogos", fields: [logoMediaId], references: [id])
  isActive        Boolean  @default(true)
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  products Product[]
}

model Attribute {
  id           Int                @id @default(autoincrement())
  name         String
  slug         String             @unique
  inputType    AttributeInputType @default(SELECT)
  isFilterable Boolean            @default(true)
  isVariant    Boolean            @default(true)
  isDisplay    Boolean            @default(false)
  createdAt    DateTime           @default(now())

  values                       AttributeValue[]
  categories                   CategoryAttribute[]
  productDisplayAttributeValue ProductDisplayAttributeValue[]
}

model AttributeValue {
  id          Int       @id @default(autoincrement())
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  colorHex    String?
  order       Int       @default(0)

  variantValues ProductVariantAttributeValue[]

  @@unique([attributeId, value])
}

// تعیین می‌کند کدام ویژگی‌ها برای کدام دسته‌بندی معنی دارند (مثلا «سایز کفش» فقط در دسته کفش)
model CategoryAttribute {
  id          Int       @id @default(autoincrement())
  categoryId  Int
  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeId])
}

// ============================================================================
// Products & Variants
// ============================================================================

model Product {
  id               Int           @id @default(autoincrement())
  name             String
  slug             String        @unique
  brandId          Int?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  shortDescription String?
  description      String?
  status           ProductStatus @default(DRAFT)
  isFeatured       Boolean       @default(false)
  viewCount        Int           @default(0)

  basePrice Int @default(0)

  pricingMode       PricingMode @default(FIXED_IRT)
  currencyId        Int?
  currency          Currency?   @relation(fields: [currencyId], references: [id])
  sourcePrice       Float?
  priceBufferPercent Float?     @default(0)
  currentPriceIRT   Int         @default(0)
  priceUpdatedAt    DateTime?

  discountType      DiscountType?
  discountValue     Int?
  // فیلدهای denormalize شده — هر بار که تنوع‌های محصول (variants) تغییر
  // می‌کند (ایجاد/ویرایش/حذف)، این مقادیر در سرویس مربوطه بازمحاسبه و
  // به‌روزرسانی می‌شوند. دلیل: مرتب‌سازی/فیلتر بر اساس قیمت یا موجودی
  // مستقیماً روی محصولات بسیار سریع‌تر و مطمئن‌تر از join زنده با variants
  // در هر کوئری لیست محصولات صفحه فروشگاه است.
  minPrice          Int           @default(0) // کمترین قیمت بین تنوع‌های فعال
  maxPrice          Int           @default(0) // بیشترین قیمت بین تنوع‌های فعال
  isInStock         Boolean       @default(false) // آیا حداقل یک تنوع فعال موجودی دارد
  hasActiveDiscount Boolean       @default(false) // آیا حداقل یک تنوع تخفیف فعال دارد
  avgRating         Float         @default(0) // میانگین امتیاز کاربران (از کامنت‌های APPROVED با rating)
  reviewCount       Int           @default(0) // تعداد کامنت‌های APPROVED دارای امتیاز
  totalSold         Int           @default(0) // تعداد کل فروش (از سفارش‌های تحویل‌شده)

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  structuredData  Json? // override دستی برای Schema.org در صورت نیاز

  createdById Int?
  createdBy   User?    @relation("ProductCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categories             ProductCategory[]
  variants               ProductVariant[]
  images                 ProductImage[]
  wishlists              Wishlist[]
  discountCodes          DiscountCodeProduct[]
  displayAttributeValues ProductDisplayAttributeValue[]
  stories                StoryProduct[]
  blogPosts              BlogPostProduct[]

  @@index([brandId])
  @@index([status])
  @@index([isFeatured])
  @@index([basePrice])
  @@index([isInStock])
  @@index([currencyId])
  @@index([currentPriceIRT])
}

// محصول می‌تواند در چند دسته‌بندی همزمان قرار بگیرد
model ProductCategory {
  id         Int      @id @default(autoincrement())
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([productId, categoryId])
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     Media   @relation(fields: [mediaId], references: [id])
  order     Int     @default(0)
  isMain    Boolean @default(false)

  @@index([productId])
}

model ProductVariant {
  id        Int     @id @default(autoincrement())
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku       String  @unique

  priceAdjustment Int     @default(0)
  stock           Int     @default(0)
  weight          Float?
  isDefault       Boolean @default(false)
  isActive        Boolean @default(true)

  // شناسه‌ی ترکیبِ مقادیر ویژگی این تنوع (مثلاً "3,7" برای رنگ=3 و سایز=7)،
  // به‌صورت شناسه‌های مرتب‌شده و جداشده با کاما — برای تنوع بدون هیچ ویژگی
  // (محصول ساده/تک‌تنوعی) مقدار رشته‌ی خالی "" است.
  // این فیلد توسط اپلیکیشن هنگام ساخت/ویرایش تنوع محاسبه و ست می‌شود، نه
  // توسط دیتابیس. هدف از @@unique زیر این است که حتی در برخورد دو درخواست
  // هم‌زمانِ ساخت یک ترکیب تکراری، خودِ دیتابیس دومی را با خطا رد کند —
  // قبلاً این بررسی فقط در کد و به‌صورت read-then-write بود که در برابر
  // درخواست‌های هم‌زمان ایمن نبود.
  comboKey String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attributeValues ProductVariantAttributeValue[]
  cartItems       CartItem[]
  orderItems      OrderItem[]

  @@unique([productId, comboKey])
  @@index([productId])
}

model ProductVariantAttributeValue {
  id               Int            @id @default(autoincrement())
  variantId        Int
  variant          ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeValueId Int
  attributeValue   AttributeValue @relation(fields: [attributeValueId], references: [id], onDelete: Cascade)

  modifierType  ModifierType?
  modifierValue Float?

  @@unique([variantId, attributeValueId])
}

model ProductDisplayAttributeValue {
  id          Int       @id @default(autoincrement())
  productId   Int
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId Int
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  value       String

  @@unique([productId, attributeId])
}

// ============================================================================
// Wishlist & Comparison
// ============================================================================

model Wishlist {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

// ============================================================================
// Cart
// ============================================================================

model Cart {
  id         Int      @id @default(autoincrement())
  userId     Int?     @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestToken String?  @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  items CartItem[]

  @@index([guestToken])
}

model CartItem {
  id        Int            @id @default(autoincrement())
  cartId    Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
}

// ============================================================================
// Discount Codes
// ============================================================================

model DiscountCode {
  id                Int          @id @default(autoincrement())
  code              String       @unique
  type              DiscountType
  value             Int // درصد یا مبلغ ثابت بسته به type
  maxDiscountAmount Int? // سقف تخفیف برای نوع درصدی
  minCartAmount     Int? // حداقل مبلغ سبد خرید برای فعال‌شدن کد

  maxUsage        Int? // حداکثر تعداد استفاده کلی از کد
  maxUsagePerUser Int? // حداکثر تعداد استفاده هر کاربر از کد
  usageCount      Int  @default(0) // شمارنده کل استفاده‌ها (برای سرعت بیشتر)

  startsAt  DateTime? // محدودیت زمانی فعال بودن کد
  expiresAt DateTime?
  isActive  Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // در صورت خالی بودن این روابط، یعنی محدودیتی روی محصول/دسته/کاربر وجود ندارد
  products   DiscountCodeProduct[]
  categories DiscountCodeCategory[]
  users      DiscountCodeUser[]
  usages     DiscountCodeUsage[]
  orders     Order[]
}

// کد تخفیف مخصوص چند محصول خاص
model DiscountCodeProduct {
  id             Int          @id @default(autoincrement())
  discountCodeId Int
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  productId      Int
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, productId])
}

// کد تخفیف مخصوص چند دسته‌بندی خاص
model DiscountCodeCategory {
  id             Int          @id @default(autoincrement())
  discountCodeId Int
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  categoryId     Int
  category       Category     @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, categoryId])
}

// کد تخفیف مخصوص چند کاربر خاص
model DiscountCodeUser {
  id             Int          @id @default(autoincrement())
  discountCodeId Int
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discountCodeId, userId])
}

// تاریخچه واقعی استفاده از کد تخفیف — مبنای محاسبه maxUsage و maxUsagePerUser
model DiscountCodeUsage {
  id             Int          @id @default(autoincrement())
  discountCodeId Int
  discountCode   DiscountCode @relation(fields: [discountCodeId], references: [id], onDelete: Cascade)
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  orderId        Int          @unique
  order          Order        @relation(fields: [orderId], references: [id])
  discountAmount Int
  usedAt         DateTime     @default(now())

  @@index([discountCodeId, userId])
}

// ============================================================================
// Shipping
// ============================================================================

model ShippingCompany {
  id               Int                @id @default(autoincrement())
  name             String
  logoUrl          String?
  logoMediaId      Int?
  logo             Media?             @relation("ShippingLogos", fields: [logoMediaId], references: [id])
  description      String?
  pricingType      ShippingPricingType @default(FIXED)
  baseCost         Int                @default(0)
  pricePerKg       Int?
  pricePerKm       Int?
  acceptsPrepay        Boolean @default(true)
  acceptsFreightCollect Boolean @default(false)
  estimatedDaysMin Int?
  estimatedDaysMax Int?
  isActive         Boolean            @default(true)

  orders Order[]
}

// ============================================================================
// Payment & Transactions
// ============================================================================

model PaymentGateway {
  id       Int     @id @default(autoincrement())
  name     String
  slug     String  @unique
  isActive Boolean @default(true)
  config   Json? // merchantId و سایر تنظیمات اتصال به درگاه

  transactions Transaction[]
}

// هر تراکنش پولی: پرداخت سفارش از درگاه، شارژ کیف پول یا بازگشت وجه
model Transaction {
  id           Int             @id @default(autoincrement())
  orderId      Int?
  order        Order?          @relation(fields: [orderId], references: [id])
  gatewayId    Int?
  gateway      PaymentGateway? @relation(fields: [gatewayId], references: [id])
  userId       Int
  user         User            @relation(fields: [userId], references: [id])
  type         TransactionType
  amount       Int
  status       PaymentStatus   @default(PENDING)
  refId        String? // شماره مرجع درگاه
  trackingCode String?         @unique
  createdAt    DateTime        @default(now())

  @@index([orderId])
  @@index([userId])
}

// ============================================================================
// Orders
// ============================================================================

model Order {
  id          Int    @id @default(autoincrement())
  orderNumber String @unique
  userId      Int
  user        User   @relation(fields: [userId], references: [id])

  // آدرس به صورت اسنپ‌شات ذخیره می‌شود تا حتی با تغییر/حذف آدرس اصلی،
  // سفارش‌های قبلی دست‌نخورده بمانند
  addressId       Int?
  address         Address? @relation(fields: [addressId], references: [id])
  shippingAddress Json? // کپی کامل آدرس در لحظه ثبت سفارش (حتی اگر آدرس اصلی بعداً تغییر/حذف شود)

  shippingCompanyId Int?
  shippingCompany   ShippingCompany? @relation(fields: [shippingCompanyId], references: [id])
  shippingCost      Int              @default(0)
  shippingWeight    Int?             // وزن کل (گرم) — برای محاسبه هزینه ارسال وزنی
  shippingDistance  Int?             // فاصله (کیلومتر) — برای محاسبه هزینه ارسال مسافتی
  trackingCode      String?
  packageNumber     String?

  subtotal       Int // جمع کل قبل از تخفیف و هزینه ارسال
  discountAmount Int @default(0)
  taxAmount      Int @default(0)
  totalAmount    Int

  discountCodeId Int?
  discountCode   DiscountCode? @relation(fields: [discountCodeId], references: [id])

  paymentMethod PaymentMethod @default(GATEWAY)
  status        OrderStatus   @default(PENDING_PAYMENT)
  paidAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items              OrderItem[]
  transactions       Transaction[]
  statusHistory      OrderStatusHistory[]
  cancellation       OrderCancellation?
  returns            OrderReturn[]
  discountUsage      DiscountCodeUsage?
  tickets            Ticket[]
  walletTransactions WalletTransaction[]

  @@index([userId])
  @@index([status])
}

model OrderItem {
  id        Int            @id @default(autoincrement())
  orderId   Int
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId Int
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  // اسنپ‌شات اطلاعات کالا در لحظه خرید (مستقل از تغییرات بعدی محصول)
  productName       String
  variantAttributes String? // خلاصه‌ای مثل «قرمز - سایز L»
  price             Int // قیمت واحد در لحظه خرید
  quantity          Int
  discountAmount    Int     @default(0)

  finalPriceIRT       Int           @default(0)
  pricingModeSnapshot PricingMode   @default(FIXED_IRT)
  sourceCurrencyCode  String?
  appliedRate         Float?

  returns OrderReturn[]

  @@index([orderId])
}

model OrderStatusHistory {
  id        Int         @id @default(autoincrement())
  orderId   Int
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  note      String?
  createdAt DateTime    @default(now())
}

model OrderCancellation {
  id          Int                @id @default(autoincrement())
  orderId     Int                @unique
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  reason      String
  status      CancellationStatus @default(PENDING)
  requestedAt DateTime           @default(now())
  reviewedAt  DateTime?
  adminNote   String?
}

model OrderReturn {
  id           Int          @id @default(autoincrement())
  orderId      Int
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId  Int?
  orderItem    OrderItem?   @relation(fields: [orderItemId], references: [id])
  reason       String
  status       ReturnStatus @default(PENDING)
  refundAmount Int?
  createdAt    DateTime     @default(now())
  reviewedAt   DateTime?
  adminNote    String?

  images OrderReturnImage[]
}

model OrderReturnImage {
  id       Int         @id @default(autoincrement())
  returnId Int
  return   OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  mediaId  Int
  media    Media       @relation(fields: [mediaId], references: [id])
}

// ============================================================================
// Wallet
// ============================================================================

model Wallet {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

model WalletTransaction {
  id          Int                   @id @default(autoincrement())
  walletId    Int
  wallet      Wallet                @relation(fields: [walletId], references: [id], onDelete: Cascade)
  type        WalletTransactionType
  amount      Int
  description String?
  orderId     Int?
  order       Order?                @relation(fields: [orderId], references: [id])
  createdAt   DateTime              @default(now())

  @@index([walletId])
}

// ============================================================================
// Tickets
// ============================================================================

model TicketDepartment {
  id   Int    @id @default(autoincrement())
  name String

  tickets Ticket[]
}

model Ticket {
  id           Int               @id @default(autoincrement())
  userId       Int
  user         User              @relation(fields: [userId], references: [id])
  departmentId Int?
  department   TicketDepartment? @relation(fields: [departmentId], references: [id])
  subject      String
  priority     TicketPriority    @default(NORMAL)
  status       TicketStatus      @default(OPEN)
  orderId      Int?
  order        Order?            @relation(fields: [orderId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id         Int        @id @default(autoincrement())
  ticketId   Int
  ticket     Ticket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   Int
  sender     User       @relation(fields: [senderId], references: [id])
  senderType SenderType
  message    String
  createdAt  DateTime   @default(now())

  attachments TicketAttachment[]
}

model TicketAttachment {
  id        Int           @id @default(autoincrement())
  messageId Int
  message   TicketMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     Media         @relation(fields: [mediaId], references: [id])
}

// ============================================================================
// Comments
// ============================================================================

model Comment {
  id              Int             @id @default(autoincrement())
  // پلی‌مورفیک: به‌جای productId مستقیم، نوع + شناسه‌ی موجودیت مرتبط
  // (چون Comment الان هم زیر محصول هم زیر پست وبلاگ استفاده می‌شود)
  commentableType CommentableType
  commentableId   Int
  userId          Int
  user            User            @relation(fields: [userId], references: [id])
  parentId        Int?
  parent          Comment?        @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[]       @relation("CommentReplies")
  content         String
  rating          Int? // امتیاز فقط روی کامنت‌های اصلی محصول (سطح اول) معنا دارد
  status          CommentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  likes       CommentLike[]
  attachments CommentAttachment[]

  @@index([commentableType, commentableId])
  @@index([parentId])
}

model CommentLike {
  id        Int      @id @default(autoincrement())
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

model CommentAttachment {
  id        Int     @id @default(autoincrement())
  commentId Int
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mediaId   Int
  media     Media   @relation(fields: [mediaId], references: [id])
}

// ============================================================================
// Blog
// ============================================================================

model BlogCategory {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  posts BlogPost[]
}

model BlogPost {
  id        Int        @id @default(autoincrement())
  title     String
  slug      String     @unique
  excerpt   String?
  content   String
  status    PostStatus @default(DRAFT)
  viewCount Int        @default(0)

  // آدرس مستقیم تصویر کاور — فرانت‌اند برای نمایش از این فیلد استفاده می‌کند
  coverImageUrl     String?
  coverImageMediaId Int?
  coverImage        Media?  @relation("BlogCoverImages", fields: [coverImageMediaId], references: [id])

  authorId Int?
  author   User? @relation("BlogPostAuthor", fields: [authorId], references: [id])

  categoryId Int?
  category   BlogCategory? @relation(fields: [categoryId], references: [id])

  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  tags            String[]  @default([])

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products BlogPostProduct[]

  @@index([status])
  @@index([categoryId])
}

model BlogPostProduct {
  id         Int      @id @default(autoincrement())
  blogPostId Int
  blogPost   BlogPost @relation(fields: [blogPostId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([blogPostId, productId])
}

// ============================================================================
// Stories
// ============================================================================

model Story {
  id                Int      @id @default(autoincrement())
  title             String
  // آدرس مستقیم تصویر کاور — فرانت‌اند برای نمایش از این فیلد استفاده می‌کند
  coverImageUrl     String?
  coverImageMediaId Int?
  coverImage        Media?   @relation("StoryCoverImages", fields: [coverImageMediaId], references: [id])
  // آدرس مستقیم ویدئو — فرانت‌اند برای نمایش از این فیلد استفاده می‌کند
  videoUrl          String?
  videoMediaId      Int?
  video             Media?   @relation("StoryVideos", fields: [videoMediaId], references: [id])
  expiresAt         DateTime
  order             Int      @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  products StoryProduct[]
}

model StoryProduct {
  id        Int     @id @default(autoincrement())
  storyId   Int
  story     Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([storyId, productId])
}

// ============================================================================
// Newsletter
// ============================================================================

model Newsletter {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================================
// Notifications
// ============================================================================

model Notification {
  id        Int              @id @default(autoincrement())
  userId    Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
}

model AdminNotification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([isRead])
}

// ============================================================================
// Banners & Popups
// ============================================================================

model Banner {
  id       Int            @id @default(autoincrement())
  title    String?
  imageUrl String?
  mediaId  Int?
  media    Media?         @relation(fields: [mediaId], references: [id])
  link     String?
  position BannerPosition
  order    Int            @default(0)
  isActive Boolean        @default(true)
  startsAt DateTime?
  endsAt   DateTime?
}

model Popup {
  id                 Int       @id @default(autoincrement())
  title              String
  content            String?
  // آدرس مستقیم فایل — فرانت‌اند برای نمایش از این فیلد استفاده می‌کند
  mediaUrl           String?
  // ارجاع به رکورد Media در کتابخانه متمرکز (برای مدیریت ادمین)
  mediaId            Int?
  media              Media?    @relation(fields: [mediaId], references: [id])
  link               String?
  isActive           Boolean   @default(true)
  startsAt           DateTime?
  endsAt             DateTime?
  showOncePerSession Boolean   @default(true)
}

// ============================================================================
// Settings & Audit
// ============================================================================

// تنظیمات کلید-مقدار قابل تغییر از پنل ادمین (نام فروشگاه، سئوی پیش‌فرض، شبکه‌های اجتماعی و ...)
model Setting {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  type      String   @default("string") // string | number | boolean | json
  updatedAt DateTime @updatedAt
}

// لاگ فعالیت‌های مهم — مبنای گزارش‌های امنیتی و برخی نمودارهای آنالیزی
model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  ip        String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
