# ----------------------------------------------------------------------------
# این فایل را کپی کنید به .env و مقادیر واقعی را جای‌گزین کنید
# cp .env.example .env
# ----------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
# APP_BASE_URL=http://mrkafshdoz.com:4000 از این مسیر قابل دسترسی است
# آدرس عمومی فرانت‌اند فروشگاه (برای sitemap.xml). اگر خالی بماند، از
# همان APP_BASE_URL استفاده می‌شود.
PUBLIC_SITE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# دیتابیس (PostgreSQL)
DATABASE_URL="postgresql://postgres:baset4591@localhost:5432/shopdb"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_please
JWT_REFRESH_SECRET=change_me_refresh_secret_please
JWT_ACCESS_EXPIRES_IN=30m
JWT_REFRESH_EXPIRES_IN=30d

# نشست‌های کاربری
MAX_ACTIVE_SESSIONS=5

# OTP
OTP_LENGTH=5
OTP_EXPIRES_IN_MINUTES=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# قفل موقت حساب پس از تلاش‌های ناموفق ورود
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_WINDOW_MINUTES=15

# Rate limiter عمومی API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- SMS Provider ---
# مقدار فعلی: mock (فقط کد را در کنسول چاپ می‌کند، برای توسعه)
# بعداً مقدار را به نام provider واقعی (kavenegar, melipayamak, ...) تغییر بده
# و فایل src/services/otp/providers را تکمیل کن
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_LINE=

# --- Email (Nodemailer SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="My Shop <no-reply@example.com>"

# --- رسانه (آپلود فایل) ---
# مسیر ذخیره‌ی فایل‌های آپلودشده روی دیسک سرور (نسبت به ریشه‌ی پروژه)
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# --- کرون‌جاب‌های پس‌زمینه ---
ENABLE_BACKGROUND_JOBS=true
JOB_CHECK_INTERVAL_MINUTES=5
ORDER_PENDING_EXPIRY_MINUTES=30
OTP_CLEANUP_RETENTION_HOURS=24

# --- نرخ ارز و قیمت‌گذاری ارزی ---
# کلید API برای BRS (provider اصلی نرخ ارز)
BRSAPI_KEY=
# کلید API برای Navasan (provider پشتیبان)
NAVASAN_API_KEY=
# درصد تغییر آستانه برای بازمحاسبه خودکار قیمت‌ها (پیش‌فرض: ۲.۵٪)
CURRENCY_UPDATE_THRESHOLD_PERCENT=2.5
# بازه زمانی حداکثر برای بازمحاسبه اجباری (ساعت)
FORCE_SYNC_INTERVAL_HOURS=12
# بازه بررسی نرخ ارز (ساعت)
RATE_FETCH_INTERVAL_HOURS=2
# آستانه تغییر قیمت قابل قبول در لحظه ثبت سفارش (درصد)
PRICE_CHANGE_THRESHOLD_PERCENT=1